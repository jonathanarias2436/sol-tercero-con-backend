arda un instante que te voy a derivar con el área correspondiente.",connectionProblem:"Hemos detectado problemas en tu conexión a internet",checkConnection:"Por favor, comprueba que esté funcionando correctamente",tryingConnect:"Estamos intentando conectarnos",weAreBack:"¡Hemos vuelto!",completeYourData:"Completá tus datos",firstname:"Nombre",lastname:"Apellido",email:"E-mail",phone:"Teléfono",send:"Enviar",cancel:"Cancelar"},products:{agentbot:{id:1,enabled:!0,default:!0},live:{id:2,enabled:!0,default:!1}}}},85033:(e,t)=>{"use strict";Object.defineProperty(t,"__esModule",{value:!0}),t.decodeBotId=void 0;t.decodeBotId=function(e){try{var t=window.atob(e);return window.atob(t)}catch(e){console.warn("error: decodeBotId")}}},49702:(e,t,a)=>{"use strict";Object.defineProperty(t,"__esModule",{value:!0});var o=a(85033);Object.keys(o).forEach(function(e){"default"!==e&&"__esModule"!==e&&(e in t&&t[e]===o[e]||Object.defineProperty(t,e,{enumerable:!0,get:function(){return o[e]}}))})},8603:(e,t,a)=>{"use strict";var o=a(37253),n=a(37557),r=a(84544),i=o(a(83787)),c=!1,s=i.default.searchInsideShadowRoot,f={isForcedLoading:function(){var e=i.default.getConfig();return Boolean(e._iqTransferring)},isLoading:function(){return i.default.getConfig()._windowLoading},scrollToMessage:function(e){var t=i.default.getConfig(),a=null==t?void 0:t.app.id,o=t._scrollToEnd,n=".agent-".concat(a," .").concat(r.KEY__MESSAGES),c=s(n)[0];if(2===e||o){if(c){var f=c.scrollHeight-c.clientHeight;"scrollTo"in c?c.scrollTo({top:f,behavior:"smooth"}):c.scrollTop=f}}else if(c){var l=c.querySelector(".".concat(r.KEY__MESSAGES_GROUP,":nth-last-child(2)"));l&&l.scrollIntoView({behavior:"smooth"})}},goToBottom:function(e){setTimeout(function(){(0,n.activeKeyboard)(),f.scrollToMessage(e)},1)},dragWindow:function(e){window.addEventListener(r.KEY__EVENT_MOUSE_UP,f.stopDragging),window.addEventListener(r.KEY__EVENT_RESIZE,f.fixAxis(e))},startDragging:function(e){var t=s(".".concat(r.KEY__CONTAINER))[0],a=s(".aivoch